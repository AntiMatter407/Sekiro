{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bash 'statusline.sh'"
  },
  "permissions": {
    "additionalDirectories": [
      "F:/UnrealEngine-5.2",
      "D:/Program Files/Epic Games/UE_5.2"
    ],
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(*)",
      "WebFetch",
      "Bash(git status)", 
      "Bash(git diff *)",       
      "Bash(git log *)",     
      "Bash(git add *)",       
      "Bash(git commit *)"     
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Write(F:/UnrealEngine-5.2/**)",
      "Edit(F:/UnrealEngine-5.2/**)",
      "Write(D:/Program Files/Epic Games/UE_5.2/**)",
      "Edit(D:/Program Files/Epic Games/UE_5.2/**)",
      "Bash(git push *)",     
      "Bash(git reset *)"      
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/secrets/**)"
    ]
  }
}
