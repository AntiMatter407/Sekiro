{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "statusLine": {
    "type": "command",
    "command": "bash 'statusline.sh'"
  },
  "permissions": {
    "additionalDirectories": [
      "F:/UnrealEngine-5.2"
    ],
    "allow": [
      "Read",
      "Write",
      "Edit",
      "Bash(*)",
      "WebFetch"
    ],
    "ask": [
      "Bash(rm -rf *)",
      "Bash(curl * | bash)",
      "Write(F:/UnrealEngine-5.2/**)",
      "Edit(F:/UnrealEngine-5.2/**)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./**/secrets/**)"
    ]
  }
}
